      {
        "article": {},
        "attachments": {},
        "author_id": "1882678524596867072",
        "conversation_id": "2056023179030892715",
        "created_at": "2026-05-17T14:44:59.000Z",
        "edit_controls": {
          "editable_until": "2026-05-17T15:44:59.000Z",
          "edits_remaining": 5,
          "is_edit_eligible": true
        },
        "edit_history_tweet_ids": [
          "2056023179030892715"
        ],
        "entities": {},
